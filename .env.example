# Temporada. En enero se calcula automáticamente la pareja del año anterior;
# estas variables permiten fijarla expresamente en producción.
LOTTERY_NAVIDAD_YEAR=2026
LOTTERY_NINO_YEAR=2027

# RTVE se consulta como máximo una vez por este intervalo. Las peticiones
# simultáneas comparten la misma descarga.
LOTTERY_SOURCE_CACHE_MS=120000
LOTTERY_SOURCE_FAILURE_CACHE_MS=30000
LOTTERY_SOURCE_TIMEOUT_MS=20000
LOTTERY_SOURCE_CONCURRENCY=5

# Solo debe cambiarse a true después de contrastar la lista definitiva de SELAE.
LOTTERY_NAVIDAD_OFFICIALLY_VERIFIED=false
LOTTERY_NINO_OFFICIALLY_VERIFIED=false

# El cron puede desactivarse localmente con el valor "no".
cron=no
environment=dev

# Opcionales: si se omiten se usa el proyecto Firebase actual de Loteriapp.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_DATABASE_URL=
# FIREBASE_PROJECT_ID=

# Las notificaciones están desactivadas salvo activación expresa.
PUSH_NOTIFICATIONS_ENABLED=false
# ONESIGNAL_USER_AUTH_KEY=
# ONESIGNAL_APP_AUTH_KEY=
# ONESIGNAL_APP_ID=
# ONESIGNAL_TEST_PLAYER_IDS=id1,id2
